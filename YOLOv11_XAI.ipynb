      "source": [
        "import ultralytics\n",
        "from ultralytics import YOLO"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "gitemOMVNuuO"
      },
      "outputs": [],
      "source": [
        "import cv2\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from PIL import Image\n",
        "\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "warnings.simplefilter('ignore')  # Suppress Matplotlib warnings"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "cjUm__HEOcxO"
      },
      "outputs": [],
      "source": [
        "plt.rcParams[\"figure.figsize\"] = [8, 8]"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "DcdJtgqJPg6_"
      },
      "outputs": [],
      "source": [
        "from yolo_cam.eigen_cam import EigenCAM\n",
        "from yolo_cam.utils.image import show_cam_on_image, scale_cam_image"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "pCwUNqsNPmGz"
      },
      "outputs": [],
      "source": [
        "model = YOLO('/content/drive/MyDrive/YOLOv11_Results/AgroPest_yolov115/weights/best.pt')\n",
        "model = model.cpu()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "ZvneTxOEPv8Y"
      },
      "outputs": [],
      "source": [
        "img = cv2.imread('/content/dataset/test/images/ants-241-_jpg.rf.e3ae012bda12b32d5a46f6b5d7c118f6.jpg')\n",
        "img = cv2.resize(img, (640, 640))\n",
        "rgb_img = img.copy()\n",
        "img = np.float32(img) / 255"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "eBEzIklQP83R"
      },
      "outputs": [],
      "source": [
        "target_layers =[model.model.model[-3]]"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 737
        },
        "id": "8TyKa5rPP_kn",
        "outputId": "140651d8-c7b4-492b-e42a-30fca5b3fdea"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "\n",
            "0: 1280x1280 1 Ants, 6213.9ms\n",
            "Speed: 30.1ms preprocess, 6213.9ms inference, 2.1ms postprocess per image at shape (1, 3, 1280, 1280)\n"
          ]
        },
        {
          "data": {
            "image/png": "",
            "text/plain": [
              "<Figure size 800x800 with 1 Axes>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "cam = EigenCAM(model, target_layers,task='od')\n",
        "grayscale_cam = cam(rgb_img)[0, :, :]\n",
        "cam_image = show_cam_on_image(img, grayscale_cam, use_rgb=True)\n",
        "plt.imshow(cam_image)\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 700
        },
        "id": "98l-sfVVwLs_",
        "outputId": "a9fbd24c-6a90-4765-a6e7-ea200857fc46"
      },
      "outputs": [
        {
          "data": {
            "text/plain": [
              "<matplotlib.image.AxesImage at 0x78f94f71b890>"
            ]
          },
          "execution_count": 64,
          "metadata": {},
          "output_type": "execute_result"
        },
        {
          "data": {
            "image/png": "",
            "text/plain": [
              "<Figure size 800x800 with 1 Axes>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "import matplotlib.pyplot as plt\n",
        "g_scale = np.stack([grayscale_cam] * 3, axis=2)\n",
        "plt.imshow(g_scale)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 611
        },
        "id": "VWufs5VLwQAc",
        "outputId": "3a87945e-1745-4c95-b428-89466bc48e8f"
      },
      "outputs": [
        {
          "data": {
            "image/jpeg": "",
            "image/png": "",
            "text/plain": [
              "<PIL.Image.Image image mode=RGB size=1280x640>"
            ]
          },
          "execution_count": 65,
          "metadata": {},
          "output_type": "execute_result"
        }
      ],
      "source": [
        "im = cv2.cvtColor(rgb_img, cv2.COLOR_RGB2BGR)\n",
        "Image.fromarray(np.hstack((im, cam_image)))"
      ]
    }
